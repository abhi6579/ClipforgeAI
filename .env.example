# ─────────────────────────────────────────────────────────────
# REQUIRED
# ─────────────────────────────────────────────────────────────

# Postgres connection string.
# Local dev is provided for you. In production use a managed DB
# (Neon, Supabase, RDS) and append ?sslmode=require
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Your public URL, no trailing slash.
# Drives canonical URLs, sitemap.xml, robots.txt and OG tags.
# MUST be set before launch or social previews break.
NEXT_PUBLIC_SITE_URL=https://clipforge.ai


# ─────────────────────────────────────────────────────────────
# OPTIONAL — the app runs fully without these
# ─────────────────────────────────────────────────────────────

# Without this key the app uses its built-in heuristic engine.
# With it, AI overviews are generated by gpt-4o-mini (~$0.0015/run).
OPENAI_API_KEY=

# Shown on the legal pages and in the footer.
SUPPORT_EMAIL=support@clipforge.ai


# ─────────────────────────────────────────────────────────────
# TO ADD WHEN YOU TURN ON PAYMENTS (see LAUNCH.md step 4)
# ─────────────────────────────────────────────────────────────
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_PRICE_CREATOR=
# STRIPE_PRICE_STUDIO=
